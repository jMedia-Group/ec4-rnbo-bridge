[Unit]
Description=Faderfox EC4 <-> RNBO runner bridge
# No ordering on rnbooscquery.service: that unit is After=multi-user.target, so ordering this
# (multi-user) unit after it creates a cycle and systemd skips the bridge at boot. The bridge
# simply retries until the runner answers.
After=network.target sound.target

[Service]
Type=simple
User=pi
Group=audio
WorkingDirectory=/home/pi/ec4-rnbo-bridge
ExecStart=/home/pi/ec4-rnbo-bridge/venv/bin/python /home/pi/ec4-rnbo-bridge/ec4bridge.py -c /home/pi/ec4-rnbo-bridge/config.json run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
