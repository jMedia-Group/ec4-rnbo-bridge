{
  "_comment": "Copy to config.json. Every key is optional; these are the defaults unless noted.",

  "runner_host": "127.0.0.1",
  "oscquery_port": 5678,
  "osc_port": 1234,
  "listen_port": 9123,
  "listen_ip": "auto",

  "midi_port": "EC4",
  "ec4_setup": 16,
  "setup_name": "RNBO",
  "resolution": "7bit",
  "encoder_mode": "Acc1",
  "display": "100",
  "cc_base": 16,

  "poll_interval": 2.0,
  "feedback_holdoff_ms": 250,

  "new_group_per_instance": true,
  "include": [],
  "exclude": ["^0/debug", "bypass"],
  "names": { "0/cutoff": "Cut", "feedback": "FB" },
  "group_names": { "0": "Syn", "1": "Echo" },
  "strip_prefixes": ["j."],
  "name_case": "keep",
  "group_title_style": "instance",
  "hide_devices": [],

  "live_names": true,
  "notify_graph_change": true,
  "notify_seconds": 2.5,
  "notify_group_change": true,
  "push_jumps_to_group": true,
  "device_list_key": "shift+16",
  "device_list_seconds": 8,
  "device_list_mode": "momentary",
  "device_list_page_seconds": 2,
  "live_names_refresh": 0,
  "zero_unused": true,
  "value_popup": true,
  "value_popup_seconds": 1.5,

  "backup_syx": "ec4-backup.syx",
  "layout_syx": "ec4-layout.syx",
  "layout_txt": "layout.txt",
  "sysex_page_pause_ms": 2
}
